# Acquired source material — re-fetchable from sources.yaml; log.md keeps the record.
bundles/*/raw/

# Agent-specific machine-local permissions; shared skills remain tracked.
.claude/settings.local.json

# Extraction cache (.ingest-cache/extracted/<sha256>.md) — re-derivable from the sources.
/.ingest-cache/

# Generated. The leading slash matters: a bare `export/` also matches the `skills/export/`
# these files ship with, and silently drops the export skill from the hub's own history.
visualizer/graph.html
/export/

# `khb go --respond` saves its account of a session where you ran `khb go` — often the hub
# itself. Derived output, and sometimes private. A response worth keeping is worth cataloging
# into a bundle as a concept doc rather than committing at the root.
khb-response-*.md
